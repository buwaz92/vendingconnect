---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="section">
    <div class="wrap narrow" style="text-align:center">
      <h1>Sorry, that page isn't here</h1>
      <p class="muted">It may have moved. Try the home page or our guides.</p>
      <p><a class="btn" href="/">Home</a> <a class="btn btn-ghost" href="/guides/">Guides</a></p>
    </div>
  </section>
</Base>
