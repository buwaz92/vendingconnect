---
// Shown after someone sends the enquiry form.
import Base from '../layouts/Base.astro';
---
<Base title="Thanks for your enquiry" noindex>
  <section class="section">
    <div class="wrap narrow" style="text-align:center">
      <h1>Thanks! We got your enquiry.</h1>
      <p class="muted">We'll be in touch soon. While you wait, have a look at our guides.</p>
      <a class="btn" href="/guides/">Browse guides</a>
    </div>
  </section>
</Base>
