---
// Automatic SEO tags for every page.
// Pages just pass a title and description; everything else is filled in for you.
import settings from '../data/settings.json';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[]; // extra structured data for Google
}

const { title, description = settings.tagline, image, type = 'website', noindex = false, schema } = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title ? `${title} | ${settings.siteName}` : `${settings.siteName} – Free Vending Machines & Vending Guides`;
const ogImage = new URL(image || '/og-default.png', site).href;

// Basic info about the business and the website. Shows on every page.
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': new URL('/#organization', site).href,
    name: settings.siteName,
    url: site.href,
    logo: new URL('/logo.png', site).href,
    ...(settings.email ? { email: settings.email } : {}),
    ...(settings.facebookUrl && settings.facebookUrl !== 'https://www.facebook.com/' ? { sameAs: [settings.facebookUrl] } : {}),
    areaServed: 'AU',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', site).href,
    name: settings.siteName,
    url: site.href,
    publisher: { '@id': new URL('/#organization', site).href },
    inLanguage: 'en-AU',
  },
];
const allSchema = [...baseSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={settings.siteName} />
<meta property="og:locale" content="en_AU" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title || fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title || fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="alternate" type="application/rss+xml" title={settings.siteName} href={new URL('/rss.xml', site).href} />
<link rel="sitemap" href="/sitemap-index.xml" />

<script type="application/ld+json" set:html={JSON.stringify(allSchema)} />
