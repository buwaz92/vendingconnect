---
// Simple vending machine logo mark + name.
---
<a href="/" class="logo" aria-label="Vending Connect Australia home">
  <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
    <rect x="4" y="2" width="26" height="30" rx="5" fill="var(--brand)" />
    <rect x="8" y="6" width="12" height="17" rx="2" fill="#fff" opacity=".95" />
    <circle cx="11" cy="10" r="1.6" fill="var(--sun)" /><circle cx="17" cy="10" r="1.6" fill="var(--sun)" />
    <circle cx="11" cy="15" r="1.6" fill="var(--sun)" /><circle cx="17" cy="15" r="1.6" fill="var(--sun)" />
    <circle cx="11" cy="20" r="1.6" fill="var(--sun)" /><circle cx="17" cy="20" r="1.6" fill="var(--sun)" />
    <rect x="22.5" y="7" width="4" height="2.5" rx="1" fill="#fff" opacity=".8" />
    <rect x="22.5" y="11.5" width="4" height="8" rx="1" fill="#fff" opacity=".35" />
    <rect x="8" y="26" width="18" height="3" rx="1.5" fill="#fff" opacity=".5" />
  </svg>
  <span><strong>Vending Connect</strong><small>Australia</small></span>
</a>
