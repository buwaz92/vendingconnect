---
// List of all guides.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PostCard from '../../components/PostCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getGuides, CATEGORIES, slugify } from '../../lib/posts';
const guides = await getGuides();
---
<Base title="Vending Business Guides" description="Practical guides on starting a vending business in Australia, choosing vending machines, finding locations and fixing common machine problems.">
  <header class="page-head">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }]} />
      <h1>Vending guides</h1>
      <p>Straightforward advice from people who repair, deliver and run vending machines every day.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <ul class="chips" style="margin-bottom:28px">
        <li><a href="/guides/" class="active">All</a></li>
        {CATEGORIES.map((c) => <li><a href={`/guides/category/${slugify(c)}/`}>{c}</a></li>)}
      </ul>
      <div class="grid-3">{guides.map((post) => <PostCard post={post} base="guides" />)}</div>
    </div>
  </section>
  <CtaBand />
</Base>
