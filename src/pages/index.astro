---
// Home page.
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getGuides, getNews, CATEGORIES, slugify } from '../lib/posts';

const guides = await getGuides();
const featured = [...guides.filter((g) => g.data.featured), ...guides.filter((g) => !g.data.featured)].slice(0, 3);
const news = (await getNews()).slice(0, 3);
---
<Base description="Get a free vending machine for your workplace in Australia. High-traffic sites may earn commission. Plus practical guides on starting and running a vending business.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Free for suitable locations*</span>
        <h1>A free vending machine for your workplace</h1>
        <p class="lead">You provide the space. A vending operator supplies the machine, keeps it stocked and looks after repairs. Busy sites may even earn commission.</p>
        <div class="hero-actions">
          <a href="/contact/" class="btn">Check my location</a>
          <a href="/locations/" class="btn btn-ghost">How it works</a>
        </div>
        <p class="small-print">*Subject to location suitability and vending operator terms.</p>
      </div>
      <div class="hero-art"><HeroArt /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-4">
        <div class="feature"><div class="icon">🥤</div><h3>Machine supplied</h3><p>No need to buy a machine for suitable sites.</p></div>
        <div class="feature"><div class="icon">📦</div><h3>Restocking done</h3><p>The operator keeps it full of drinks and snacks.</p></div>
        <div class="feature"><div class="icon">🔧</div><h3>Repairs handled</h3><p>Servicing and fixes are looked after for you.</p></div>
        <div class="feature"><div class="icon">💰</div><h3>Possible commission</h3><p>High-traffic sites may earn a share of sales.*</p></div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Vending guides</h2>
        <a href="/guides/">See all guides →</a>
      </div>
      <ul class="chips" style="margin-bottom:24px">
        {CATEGORIES.map((c) => <li><a href={`/guides/category/${slugify(c)}/`}>{c}</a></li>)}
      </ul>
      <div class="grid-3">
        {featured.map((post) => <PostCard post={post} base="guides" />)}
      </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>Latest news</h2>
          <a href="/news/">All news →</a>
        </div>
        <div class="grid-3">
          {news.map((post) => <PostCard post={post} base="news" />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>
