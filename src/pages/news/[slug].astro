---
// One page per news post.
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getNews } from '../../lib/posts';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((post) => ({ params: { slug: post.id }, props: { post, related: news.filter((n) => n.id !== post.id).slice(0, 3) } }));
}
const { post, related } = Astro.props;
const { Content, headings } = await render(post);
---
<Article post={post} base="news" headings={headings} related={related}><Content /></Article>
