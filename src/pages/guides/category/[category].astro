---
// One page per guide category, made automatically.
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PostCard from '../../../components/PostCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getGuides, CATEGORIES, slugify } from '../../../lib/posts';

export async function getStaticPaths() {
  return CATEGORIES.map((name) => ({ params: { category: slugify(name) }, props: { name } }));
}
const { name } = Astro.props;
const guides = (await getGuides()).filter((g) => g.data.category === name);
---
<Base title={`${name} – Vending Guides`} description={`Vending guides about ${name.toLowerCase()} for Australian vending operators and businesses.`} noindex={guides.length === 0}>
  <header class="page-head">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name, href: `/guides/category/${slugify(name)}/` }]} />
      <h1>{name}</h1>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <ul class="chips" style="margin-bottom:28px">
        <li><a href="/guides/">All</a></li>
        {CATEGORIES.map((c) => <li><a href={`/guides/category/${slugify(c)}/`} class={c === name ? 'active' : ''}>{c}</a></li>)}
      </ul>
      {guides.length
        ? <div class="grid-3">{guides.map((post) => <PostCard post={post} base="guides" />)}</div>
        : <p class="muted">No guides here yet. Check back soon.</p>}
    </div>
  </section>
  <CtaBand />
</Base>
