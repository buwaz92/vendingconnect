---
// Drawing of a vending machine for the home page.
---
<svg width="260" height="340" viewBox="0 0 260 340" role="img" aria-label="Illustration of a drinks and snacks vending machine">
  <circle cx="205" cy="55" r="38" fill="var(--sun)" opacity=".9" />
  <rect x="30" y="20" width="190" height="300" rx="22" fill="var(--brand)" />
  <rect x="48" y="40" width="112" height="200" rx="10" fill="#fff" />
  <g fill="var(--sun)">
    <rect x="60" y="55" width="22" height="34" rx="6" /><rect x="93" y="55" width="22" height="34" rx="6" /><rect x="126" y="55" width="22" height="34" rx="6" />
  </g>
  <g fill="#5fb3bf">
    <rect x="60" y="105" width="22" height="34" rx="6" /><rect x="93" y="105" width="22" height="34" rx="6" /><rect x="126" y="105" width="22" height="34" rx="6" />
  </g>
  <g fill="#f07167">
    <rect x="60" y="155" width="22" height="26" rx="4" /><rect x="93" y="155" width="22" height="26" rx="4" /><rect x="126" y="155" width="22" height="26" rx="4" />
  </g>
  <g fill="var(--brand-soft)"><rect x="56" y="94" width="96" height="3" rx="1.5" /><rect x="56" y="144" width="96" height="3" rx="1.5" /><rect x="56" y="188" width="96" height="3" rx="1.5" /></g>
  <rect x="172" y="44" width="34" height="22" rx="4" fill="#d9f0f2" />
  <g fill="#fff" opacity=".85">
    <circle cx="181" cy="82" r="4" /><circle cx="197" cy="82" r="4" /><circle cx="181" cy="96" r="4" /><circle cx="197" cy="96" r="4" /><circle cx="181" cy="110" r="4" /><circle cx="197" cy="110" r="4" />
  </g>
  <rect x="176" y="128" width="26" height="40" rx="5" fill="#fff" opacity=".3" />
  <rect x="62" y="258" width="126" height="34" rx="8" fill="var(--brand-dark)" />
  <rect x="45" y="320" width="30" height="10" rx="3" fill="var(--brand-dark)" /><rect x="175" y="320" width="30" height="10" rx="3" fill="var(--brand-dark)" />
</svg>
